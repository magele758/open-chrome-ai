{
  "manifest_version": 3,
  "name": "PageLens",
  "version": "0.10.0",
  "minimum_chrome_version": "116",
  "description": "侧栏页面 Agent：读网页/PDF/视频，并用 Chrome 扩展 API 作为工具。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "PageLens",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "sidePanel",
    "storage",
    "scripting",
    "tabs",
    "tabGroups",
    "contextMenus",
    "bookmarks",
    "history",
    "notifications",
    "clipboardWrite",
    "clipboardRead",
    "unlimitedStorage",
    "tabCapture",
    "offscreen",
    "nativeMessaging",
    "tts",
    "alarms",
    "webNavigation",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*",
    "file://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "skills/*"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+L",
        "mac": "Alt+L"
      },
      "description": "打开 PageLens 侧栏"
    }
  }
}
